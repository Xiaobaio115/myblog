# 本地开发环境变量示例
# 复制为 .env.local 后填写真实值；不要提交 .env.local。

# MongoDB / 后台 / Vercel Blob
MONGODB_URI=
MONGODB_DB=
ADMIN_PASSWORD=
BLOB_READ_WRITE_TOKEN=

# 右下角 AI 聊天（当前支持 OpenAI-compatible /chat/completions 接口）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_DAILY_LIMIT=10

# 手机消息通知（二选一或同时启用）
# Server酱：访问 https://sct.ftqq.com/ 绑定微信后获取 SendKey。
SERVERCHAN_SEND_KEY=

# 通用 Webhook：收到 JSON；若服务要求 Bearer Token，再配置 CHAT_WEBHOOK_TOKEN。
CHAT_WEBHOOK_URL=
CHAT_WEBHOOK_TOKEN=

# 可选第三方服务
TWIKOO_ENV_ID=
